# Local (Vite proxy): leave empty so the browser calls /api on the same origin.
VITE_API_BASE_URL=

# Production / tunnel: set the absolute API URL, e.g.
# VITE_API_BASE_URL=https://api.example.com

# Optional local-only Telegram initData for non-Telegram browsers (never commit real secrets)
# VITE_DEV_TELEGRAM_INIT_DATA=
